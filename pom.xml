<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.mohs</groupId>
    <artifactId>mohs-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Mohs</name>
    <description>Job scheduling for Java/Spring Boot</description>

    <modules>
        <module>mohs-cron</module>
        <module>mohs-core</module>
        <module>mohs-engine</module>
        <module>mohs-jdbc</module>
        <module>mohs-rest</module>
        <module>mohs-ui</module>
        <module>mohs-test</module>
        <module>mohs-spring-boot-starter</module>
        <module>mohs-demo</module>
        <module>mohs-bom</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.0</spring-boot.version>
        <uuidv7.version>1.1.0</uuidv7.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <!--
        Sem <parent> spring-boot-starter-parent: este reator é um conjunto de bibliotecas, não
        uma aplicação. Importar a BOM alinha as versões gerenciadas pelo Spring Boot sem herdar
        os defaults de aplicação do starter-parent (repackage do spring-boot-maven-plugin,
        filtering de application.yaml). O único módulo que é aplicação — mohs-demo — declara o
        plugin de repackage por conta própria.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.mohs</groupId>
                <artifactId>mohs-cron</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mohs</groupId>
                <artifactId>mohs-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mohs</groupId>
                <artifactId>mohs-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mohs</groupId>
                <artifactId>mohs-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mohs</groupId>
                <artifactId>mohs-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mohs</groupId>
                <artifactId>mohs-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mohs</groupId>
                <artifactId>mohs-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mohs</groupId>
                <artifactId>mohs-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.robsonkades</groupId>
                <artifactId>uuidv7</artifactId>
                <version>${uuidv7.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JSpecify em todo módulo: cada package-info de produção carrega @NullMarked
             (CLAUDE.md). Chegava de graça via spring-core no módulo único; agora que
             mohs-cron não depende de Spring nenhum, é declarado aqui uma vez só. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- JUnit + AssertJ + Mockito para todo módulo, escopo test. Antes vinham
             transitivamente do único spring-boot-starter-webmvc-test do módulo único; os
             módulos que precisam da fatia MVC continuam declarando aquele por cima. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!-- Spring MVC resolve nome de @RequestParam/@PathVariable por reflexão;
                             o starter-parent ligava isso por default e este reator não o herda. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
